{
  "name": "deepseek-harness-wallet",
  "description": "Local-first account monitoring, usage accounting, official recharge, completion reminders, flexible layout, host-gated session controls, and multi-account management with hot account switching for DeepSeek Harness.",
  "version": "0.2.3",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "integrations/dsh-session-delete/**"
  ],
  "license": "MIT",
  "scripts": {
    "check:syntax": "node --check index.js && node --check lib/client.js",
    "check:pack": "node scripts/verify-pack.mjs",
    "test": "node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "balance-monitor",
    "recharge",
    "token-tracking",
    "cost-tracking",
    "wallet",
    "multi-account",
    "account-switching",
    "llm",
    "agentic-ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feibi-mochi/deepseek-harness-control-center.git"
  },
  "homepage": "https://github.com/feibi-mochi/deepseek-harness-control-center#readme",
  "bugs": {
    "url": "https://github.com/feibi-mochi/deepseek-harness-control-center/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
