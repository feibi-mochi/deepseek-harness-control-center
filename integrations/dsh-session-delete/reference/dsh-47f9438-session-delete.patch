+  /**
+   * Invalidate a cold cached source before permanent deletion. An exclusive
+   * resume reservation is an owner and therefore blocks deletion; a loading
+   * or committing source is serialized by the coordinator and reaches ready
+   * before this method is called.
+   * @param id - session identity being deleted.
+   */
+  invalidateForDelete(id: SessionId): void {
+    const entry = this.entries.get(id)
+    if (entry === undefined) return
+    if (entry.phase !== 'ready') {
+      throw new Error(`cannot delete session "${id}" while its persisted preparation is ${entry.phase}`)
+    }
+    this.remove(entry)
+  }
